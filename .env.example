# =========================================
# Zonvo AI - Environment Variables Template
# =========================================
# 
# QUICK START:
# 1. Copy this file: cp .env.example .env
# 2. Run setup: npm run setup (auto-generates security secrets)
# 3. Fill in the remaining values below
# 4. Initialize database: npm run db:push && npm run db:seed
# 5. Start: npm run build && npm run start
#
# NEVER commit .env to version control!
# =========================================

# =========================================
# Database Configuration
# =========================================
PGHOST=postgres
PGPORT=5432
PGUSER=Zonvo AI
PGPASSWORD=your_secure_database_password_here
PGDATABASE=Zonvo AI
DATABASE_URL=postgresql://Zonvo AI:your_secure_database_password_here@postgres:5432/Zonvo AI

# =========================================
# Application Configuration
# =========================================
NODE_ENV=production
PORT=5000
APP_PORT=5000
APP_URL=https://yourdomain.com

# =========================================
# Security Secrets (Auto-generated by: npm run setup)
# =========================================
# These are automatically generated when you run: npm run setup
# Do not modify manually - just run the setup command

# Session encryption key (64 characters)
SESSION_SECRET=WILL_BE_AUTO_GENERATED_BY_SETUP

# JWT signing key for authentication tokens (64 characters)
JWT_SECRET=WILL_BE_AUTO_GENERATED_BY_SETUP

# =========================================
# Twilio Configuration
# =========================================
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# =========================================
# ElevenLabs Configuration
# =========================================
# Get from: https://elevenlabs.io/app/settings/api-keys
# Note: You can add multiple keys via the admin panel after installation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# =========================================
# Stripe Configuration (Production)
# =========================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# =========================================
# Stripe Configuration (Testing - Optional)
# =========================================
# For testing in production environment
TESTING_STRIPE_SECRET_KEY=your_testing_stripe_secret_key_here
TESTING_VITE_STRIPE_PUBLIC_KEY=your_testing_stripe_public_key_here

# =========================================
# SMTP Email Configuration
# =========================================
# Required for OTP email verification during user signup
# Gmail example (you can use any SMTP provider):
# 1. Go to Google Account Settings
# 2. Enable 2-Step Verification
# 3. Generate an "App Password" for "Mail"
# Other providers: SendGrid, Mailgun, AWS SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# =========================================
# Redis & BullMQ Configuration (Distributed Mode)
# =========================================
# Enable background job processing via BullMQ (opt-in)
# If false, Zonvo AI will fall back to legacy, in-memory single-node loops
ENABLE_BULLMQ=false

# Redis connection URL for worker queue and pub/sub synchronization
REDIS_URL=redis://localhost:6379

# Concurrency limit for BullMQ background workers
BULLMQ_MAX_CONCURRENT_CALLS=10

# Max age for stuck campaigns before worker automatically marks them as failed (in ms, default 30 mins)
BULLMQ_STUCK_CAMPAIGN_MAX_AGE_MS=1800000

# Max age for stale calls before worker automatically marks them as failed (in ms, default 1 hour)
BULLMQ_STALE_CALL_MAX_AGE_MS=3600000

# Time interval for checking and recovering stuck campaigns (in ms, default 5 mins)
BULLMQ_RECOVERY_CHECK_INTERVAL_MS=300000

# Time interval for cleaning up stale calls (in ms, default 15 mins)
BULLMQ_STALE_CLEANUP_INTERVAL_MS=900000

# =========================================
# Installation Configuration
# =========================================
# These are automatically managed by the installer
# Do not modify manually unless you know what you're doing
INSTALLER_COMPLETED=false
INSTALLER_VERSION=1.0.0